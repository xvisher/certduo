# ─── Database ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (get from neon.tech dashboard)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# ─── Microsoft Entra ID (Azure AD) ────────────────────────────────────────────
# Create an App Registration in portal.azure.com
# Platform: Single-page application
# Redirect URI: https://yourdomain.com/auth/callback
MSAL_CLIENT_ID=your-app-client-id
MSAL_CLIENT_SECRET=your-app-client-secret
MSAL_TENANT_ID=common
MSAL_REDIRECT_URI=https://yourdomain.com/auth/callback

# Public variants (exposed to browser via NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_MSAL_CLIENT_ID=your-app-client-id
NEXT_PUBLIC_MSAL_TENANT_ID=common
NEXT_PUBLIC_MSAL_REDIRECT_URI=https://yourdomain.com/auth/callback

# ─── Session ──────────────────────────────────────────────────────────────────
# 32-byte base64 secret — generate with: openssl rand -base64 32
SESSION_SECRET=your-session-secret-base64

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NODE_ENV=production
